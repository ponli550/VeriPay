DEEPSEEK_API_KEY=your-key-here
DEMO_FALLBACK=0
# Solana devnet — verification-gated payments. NEVER commit a funded key.
SOLANA_SECRET_KEY=base58-64-byte-keypair-here
SOLANA_RPC_URL=https://api.devnet.solana.com
VERIPAY_RECIPIENT=devnet-pubkey-to-pay
# Contribution / tips card (optional): your real Hata deposit address on
# Solana (or any wallet). Card stays hidden while unset.
VERIPAY_WALLET_ADDRESS=
VERIPAY_WALLET_URL=
# Hata (licensed MY exchange) — READ-ONLY deposit-address fetch for the
# contribution card. Optional; VERIPAY_WALLET_ADDRESS above wins if set.
HATA_API_KEY=
HATA_API_SECRET=
